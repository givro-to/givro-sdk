{
  "name": "givro-sdk",
  "version": "0.1.0",
  "description": "Givro SDK for identifier-routed EVM, Tron, and future Solana payment integrations",
  "keywords": [
    "givro",
    "payments",
    "crypto-payments",
    "stablecoin",
    "evm",
    "tron",
    "solana",
    "web3",
    "escrow"
  ],
  "homepage": "https://givro.to/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/givro-to/givro-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/givro-to/givro-sdk/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run --exclude 'tests/e2e/**' --exclude '**/node_modules/**'",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit --project tsconfig.test.json"
  },
  "peerDependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
