# Required: Enterprise API key from https://givro.to/enterprise (API Keys tab).
# Use a test key first (gvr_test_...). Live keys (gvr_live_...) may need dual approval.
GIVRO_API_KEY=gvr_test_replace_me

# Givro API base (no trailing slash)
GIVRO_API_BASE=https://givro.to

# Must match the API key environment: test | live
GIVRO_ENVIRONMENT=test

# Merchant receiving identity (who receives the payment when the payer funds)
# Phase one: email or X handle (without @ for API body; UI can show @)
GIVRO_RECIPIENT_KIND=email
GIVRO_RECIPIENT_IDENTIFIER=merchant@example.com

# Payment defaults shown on the demo page (can still be edited in the UI)
GIVRO_AMOUNT=1.00
# Chain must match the API key environment: 84532 (Base Sepolia) for test, 8453 (Base) for live.
GIVRO_CHAIN_ID=84532
GIVRO_ECOSYSTEM=evm
# Token symbol (ETH / USDC / ...), resolved by Givro for the chain above.
GIVRO_TOKEN_SYMBOL=ETH
# Or pin an exact contract address instead (wins over GIVRO_TOKEN_SYMBOL), e.g. Base mainnet USDC:
# GIVRO_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
GIVRO_FEE_PAYER=payer
GIVRO_MESSAGE=Demo invoice from enterprise-pay-link-demo

# Local demo server
PORT=3847
