# Required: Enterprise API key from https://hfi.network/enterprise (API Keys tab).
# Use a test key first (hfi_test_...). Live keys (hfi_live_...) may need dual approval.
HFI_API_KEY=hfi_test_replace_me

# HFI API base (no trailing slash)
HFI_API_BASE=https://hfi.network

# Must match the API key environment: test | live
HFI_ENVIRONMENT=test

# Merchant receiving identity (who receives the payment when the payer funds)
# Phase one: email or X handle (without @ for API body; UI can show @)
HFI_RECIPIENT_KIND=email
HFI_RECIPIENT_IDENTIFIER=merchant@example.com

# Payment defaults shown on the demo page (can still be edited in the UI)
HFI_AMOUNT=1.00
# Chain must match the API key environment: 84532 (Base Sepolia) for test, 8453 (Base) for live.
HFI_CHAIN_ID=84532
HFI_ECOSYSTEM=evm
# Token symbol (ETH / USDC / ...), resolved by HFI for the chain above.
HFI_TOKEN_SYMBOL=ETH
# Or pin an exact contract address instead (wins over HFI_TOKEN_SYMBOL), e.g. Base mainnet USDC:
# HFI_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
HFI_FEE_PAYER=payer
HFI_MESSAGE=Demo invoice from enterprise-pay-link-demo

# Local demo server
PORT=3847
